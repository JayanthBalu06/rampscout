# --- Core ---
DATABASE_URL=postgresql+psycopg://rampscout:rampscout@localhost:5432/rampscout
TEST_DATABASE_URL=postgresql+psycopg://rampscout:rampscout@localhost:5432/rampscout_test
CORS_ORIGINS=http://localhost:5173

# --- Demo clock & agent ---
DEMO_MODE=true
CLOCK_MODE=fixture                # fixture (manual demo clock) | system (wall clock)
DEMO_CLOCK_START=2026-11-27T17:00:00Z   # Fri 2026-11-27 11:00 America/Mexico_City
DEMO_TICK_SECONDS=900
QUOTE_TTL_SECONDS=120
SAFETY_MARGIN_SECONDS=120
PROVIDER_TIMEOUT_MS=1500
POLL_INTERVAL_SECONDS=30
WORKER_LOOP_SECONDS=2
MAX_AUTHORIZATION_USDC=1000      # hard cap on any single authorization
MAX_WATCH_DAYS=7

# --- Settlement (missing RPC_URL or SIGNER_PRIVATE_KEY => simulated mode) ---
RPC_URL=                           # e.g. https://sepolia.base.org (rate-limited) or an Alchemy/QuickNode URL
RPC_SEND_URL=                      # optional, e.g. https://sepolia-sequencer.base.org
RECEIPT_WAIT_SECONDS=30
EXPECTED_CHAIN_ID=84532
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SIGNER_PRIVATE_KEY=
SIGNER_ADDRESS=
ROUTE_A_SETTLEMENT_ADDRESS=
ROUTE_B_SETTLEMENT_ADDRESS=
DEMO_TRANSFER_SCALE=0.01           # 600 USDC authorized -> 6.00 test USDC sent onchain (labeled in receipt)
MAX_ONCHAIN_TRANSFER_USDC=10
DAILY_ONCHAIN_RUNS=20
EXPLORER_TX_URL=https://sepolia.basescan.org/tx/

# --- Optional LLM (form works without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_SECONDS=20
